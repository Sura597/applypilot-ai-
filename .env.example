# ==============================================================
# ApplyPilot AI Environment Configuration (.env.example)
# Copy this file to .env and configure your desired credentials.
# ==============================================================

# Application & Server
DEBUG=True
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (Default: local SQLite database, or set to PostgreSQL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/applypilot
DATABASE_URL=sqlite:///./applypilot.db

# LLM Providers (Optional: system runs in high-fidelity deterministic mode if keys are absent)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Meta WhatsApp Cloud API (Optional: interactive simulator works in browser out of the box)
# Meta Developer Portal: https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=applypilot_verify_token_secure_2026
WHATSAPP_API_VERSION=v21.0
